*{box-sizing:border-box}
:root{color-scheme:dark;--bg:#0b1120;--panel:#111b2e;--panel2:#17243a;--border:#293850;--text:#eef4ff;--muted:#9aaac2;--accent:#70a5ff;--danger:#ff747d;--ok:#69d7a3}
body{margin:0;background:radial-gradient(ellipse at top,#172742 0,#0b1120 55%);color:var(--text);font-family:Inter,Segoe UI,Arial,sans-serif;min-height:100vh}
button,input,textarea,select{font:inherit}
button,.button{border:0;border-radius:10px;padding:10px 15px;cursor:pointer;font-weight:650;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}
button:disabled{opacity:.45;cursor:not-allowed}
.primary{background:var(--accent);color:#071326}.secondary,.button.secondary{background:#24334c;color:var(--text);border:1px solid #3a4c68}
.full{width:100%;margin-top:20px;padding:13px}
.shell{width:min(1440px,94%);margin:0 auto;padding:34px 0 60px}
[hidden]{display:none!important}
.login-card{width:min(430px,100%);margin:8vh auto;background:rgba(17,27,46,.96);border:1px solid var(--border);border-radius:20px;padding:32px;box-shadow:0 25px 90px #0005}
.brand-mark{font-size:11px;letter-spacing:.2em;color:var(--accent);font-weight:800}
h1{font-size:clamp(25px,4vw,34px);margin:8px 0 10px}h2{margin:0 0 6px;font-size:22px}h3{margin:0 0 18px}.muted{color:var(--muted);line-height:1.5}
label{display:block;color:#c8d5e9;font-size:13px;margin:12px 0 7px}
input,textarea,select{width:100%;background:#0b1425;color:var(--text);border:1px solid #354661;border-radius:9px;padding:11px 12px;outline:none;min-width:0}
input:focus,textarea:focus,select:focus{border-color:var(--accent);box-shadow:0 0 0 3px #70a5ff20}
.message{min-height:20px;color:var(--muted);font-size:14px}.message.error{color:var(--danger)}.message.success{color:var(--ok)}
.topbar,.section-heading,.top-actions,.form-actions,.toolbar-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.topbar{margin-bottom:26px}.top-actions{justify-content:flex-end}
.stats-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin-bottom:24px}
.stat,.panel{background:rgba(17,27,46,.96);border:1px solid var(--border);border-radius:16px}
.stat{padding:19px}.stat span{display:block;color:var(--muted);font-size:13px}.stat strong{display:block;font-size:29px;margin-top:8px}
.tabs{display:flex;gap:8px;margin:0 0 14px}.tab{background:transparent;color:var(--muted);border:1px solid var(--border)}.tab.active{background:var(--panel2);color:var(--text);border-color:var(--accent)}
.panel{padding:22px;margin-bottom:18px}.section-heading{margin-bottom:18px}
.product-form{background:#0c1628;border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:18px}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 16px}.wide{grid-column:1/-1}.form-actions{justify-content:flex-start;margin-top:18px}
.table-wrap{width:100%;overflow:auto}
table{width:100%;border-collapse:collapse;min-width:800px}th,td{text-align:left;padding:13px 12px;border-bottom:1px solid var(--border);vertical-align:top;font-size:13px}th{color:#b7c8e2;font-size:12px;text-transform:uppercase;letter-spacing:.04em}td{color:#e0e9f8}
td .muted{font-size:12px}.actions{display:flex;gap:7px;flex-wrap:wrap}.actions button{padding:7px 10px;font-size:12px}.danger{background:#4a202b;color:#ffdce0;border:1px solid #71313d}
.status-select{min-width:155px;padding:8px}.order-items{min-width:170px;line-height:1.6}
.filters{display:grid;grid-template-columns:minmax(220px,2fr) repeat(3,minmax(130px,1fr)) auto;gap:12px;align-items:end;padding:15px;background:#0c1628;border:1px solid var(--border);border-radius:12px;margin-bottom:15px}
.filters label{margin-top:0}.filters .search-field{min-width:220px}.filter-buttons{padding-bottom:1px}.filter-buttons button{white-space:nowrap}
.results-line{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:13px;margin:12px 0}
.pagination{display:flex;justify-content:center;align-items:center;gap:18px;padding:20px 0 4px}.pagination span{color:var(--muted);font-size:13px}
.status-pill{display:inline-block;padding:5px 9px;border:1px solid var(--border);border-radius:999px;font-size:12px;white-space:nowrap}
.status-pill.good{color:var(--ok);border-color:#286c52}.status-pill.bad{color:#ff9ba2;border-color:#71313d}.status-pill.wait{color:#ffd78a;border-color:#705b2b}
.order-dialog{width:min(720px,92vw);max-height:85vh;overflow:auto;background:var(--panel);color:var(--text);border:1px solid var(--border);border-radius:16px;padding:24px}
.order-dialog::backdrop{background:#030712c9;backdrop-filter:blur(4px)}.dialog-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:22px}
.detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.detail-card{background:#0b1425;border:1px solid var(--border);padding:13px;border-radius:10px;overflow-wrap:anywhere}.detail-card span{display:block;color:var(--muted);font-size:12px;margin-bottom:6px}.detail-card strong{font-size:14px;white-space:pre-wrap}
.detail-items{width:100%;min-width:0;margin-top:16px}.detail-total{display:flex;justify-content:space-between;font-size:18px;font-weight:750;margin-top:18px}
@media(max-width:1100px){.filters{grid-template-columns:repeat(2,minmax(0,1fr))}.filters .search-field{grid-column:1/-1}.filter-buttons{align-self:end}.stats-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:650px){.shell{width:92%;padding-top:20px}.panel{padding:14px}.login-card{padding:23px}.form-grid,.detail-grid{grid-template-columns:1fr}.wide{grid-column:auto}.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.stat{padding:14px}.stat strong{font-size:24px}.topbar{align-items:flex-start}.filters{grid-template-columns:1fr}.filters .search-field{grid-column:auto}.pagination{gap:10px}.pagination button{padding:9px}.order-dialog{padding:16px}}
